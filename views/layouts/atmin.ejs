<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= title || Lably %></title>

    <!-- Meta Tags -->
    <% if (meta) { %> <%- meta %> <% } %>

    <link rel="icon" type="image/png" href="/assets/logo.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Sansation:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
    />

    <!-- Global CSS -->
    <link rel="stylesheet" href="/css/sidebar.css" />

    <!-- CSS Tambahan -->
    <% if (style) { %> <%- style %> <% } %>
</head>
<body> 
    <!-- === POPUP NOTIFICATION === -->
    <% const _showPopup = (typeof showPopup === "undefined") ? false : showPopup; %>

    <% if (_showPopup && message) { %>
        <div class="popup <%= message.type %>">
            <%= message.text %>
        </div>
    <% } %>



    <!-- Sidebar Partial -->
    <div class="container">
        <div class="left">
            <%- include('../partials/sidebar') %>
        </div>
        <div class="right">
            <%- content %>
        </div>
    </div>
</body>
</html>