<div class="container main-content" id="main-content">
  <div class="top-section">
    <h1 class="order-title">YOUR ORDERS</h1>
    <div class="filters">
      <button class="filter-btn active" id="filter-all">ALL ORDERS</button>
      <button class="filter-btn inactive" id="filter-loaned">LOANED</button>
      <button class="filter-btn inactive" id="filter-completed">
        COMPLETED
      </button>
    </div>
  </div>

  <div class="order-card-list">

  <% if (!orders || orders.length === 0) { %>
      <p style="text-align:center; margin-top:20px;">No orders found.</p>
  <% } else { %>

      <% orders.forEach(order => { %>

      <div 
        class="order-card" 
        data-status="<%= 
            order.status === 'pending' ? 'paid' : 
            order.status === 'in use' ? 'in-use' :
            order.status === 'overdue' ? 'overdue' :
            order.status === 'completed' ? 'complete' : 'paid'
        %>"
      >
        <img 
  src="<%= order.product_image ? '/uploads/' + order.product_image : '/Assets/default.png' %>" 
  class="product-image"
/>

        <div class="order-details">

          <div class="detail-item">
            <span class="detail-label">NAMA PRODUCT :</span>
            <span class="detail-value product-name"><%= order.product_name %></span>
          </div>

          <div class="detail-item">
            <span class="detail-label">QUANTITY PRODUCT :</span>
            <span class="detail-value"><%= order.qty %>x</span>
          </div>

          <div class="detail-item detail-all-orders">
            <span class="detail-label">TOTAL PRODUCT :</span>
            <span class="detail-value">Rp<%= Number(order.price).toLocaleString() %></span>
          </div>

          <div class="detail-item detail-all-orders">
            <span class="detail-label">LOAN DATE :</span>
            <span class="detail-value"><%= order.tgl_pinjam %> - <%= order.tgl_kembali %></span>
          </div>

          <!-- 
          <% if (order.status === 'in use' || order.status === 'overdue') { %>
            <div class="detail-item detail-loaned">
              <span class="detail-label">LOAN FROM :</span>
              <span class="detail-value"><%= order.tgl_pinjam %></span>
            </div>
            <div class="detail-item detail-loaned">
              <span class="detail-label">LOAN UNTIL :</span>
              <span class="detail-value"><%= order.tgl_kembali %></span>
            </div>
          <% } %>
          -->

          <div class="detail-item status-col">
            <span class="detail-label">STATUS :</span>
            <span 
              class="status-badge 
                <%= order.status === 'pending' ? 'paid' :
                    order.status === 'in use' ? 'in-use' :
                    order.status === 'overdue' ? 'overdue' :
                    order.status === 'completed' ? 'complete' : ''
              %>"
            >
              <%= 
                order.status === 'pending' ? "Paid" :
                order.status === 'in use' ? "IN USE" :
                order.status === 'overdue' ? "Overdue" :
                order.status === 'completed' ? "Returned" :
                ""
              %>
            </span>
          </div>

        </div>
      </div>

      <% }) %>

  <% } %>

</div>



