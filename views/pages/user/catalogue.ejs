<!-- Hero Section -->
<section class="hero-section">
  <div class="container hero-content">
    <h1>Our Catalogue</h1>
  </div>
</section>

<!-- Edge Section -->
<section>
  <div class="edge"></div>
</section>

<!-- Catalogue Section -->
<section class="catalogue">
  <div class="container filter-container">
    <div class="filter-wrap">
      <div class="filter-group">
        <select class="custom-select" aria-label="Filter by Category">
          <option selected disabled>Categories</option>
          <option value="mikroskop">Mikroskop</option>
          <option value="sentrifuga">Sentrifuga</option>
          <option value="inkubator">Inkubator</option>
          <option value="reaktor">Reaktor</option>
        </select>
        <i class="bi bi-chevron-down"></i>
      </div>
      <div class="filter-group">
        <select class="custom-select" aria-label="Filter by Price">
          <option selected disabled>Price</option>
          <option value="0-500000">IDR 0 - 500rb</option>
          <option value="500001-1000000">IDR 500rb - 1jt</option>
          <option value="1000001-2000000">IDR 1jt - 2jt</option>
          <option value="2000001-above">IDR 2jt+</option>
        </select>
        <i class="bi bi-chevron-down"></i>
      </div>
    </div>

    <div class="search-group">
      <i class="bi bi-search search-icon"></i>
      <input
        type="text"
        class="search-input"
        placeholder="Search"
        aria-label="Search items"
      />
    </div>
  </div>

  <div class="container catalogue-content">
    <div class="catalogue-grid">
      <% products.forEach(p => { %>
        <a href="/product/<%= p.id %>">
          <div class="catalogue-item">
            <div class="item-img">
              <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" />
            </div>
              <p class="item-name"><%= p.name %></p>
              <p class="item-price">IDR <%= Number(p.price).toLocaleString("id-ID") %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </div>

  <nav aria-label="Page navigation">
    <ul class="pagination">
      <li>
        <a href="#" class="page-link active" aria-current="page">1</a>
      </li>
      <li>
        <a href="#" class="page-link">2</a>
      </li>
      <li>
        <a href="#" class="page-link next-page" aria-label="Next">
          <span aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
        </a>
      </li>
    </ul>
  </nav>
</section>
