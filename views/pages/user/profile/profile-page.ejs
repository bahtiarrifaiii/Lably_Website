<!-- profile-page.ejs -->

<div class="profile-content">
  <!-- HEADER -->
  <div class="profile-header">
    <h1>Profile</h1>
    <p>Kelola informasi akun Anda</p>
  </div>

  <div class="profile-body">
    <!-- KIRI: Informasi Pribadi -->
    <div class="profile-card info-card">
      <div class="card-title">
        <h2>Informasi Pribadi</h2>
        <p>Perbarui informasi pribadi Anda</p>
      </div>

      <form action="/profile-customer/update" method="POST">
        <div class="form-group">
          <label for="nama">Nama Lengkap</label>
          <input
            type="text"
            id="nama"
            name="username"
            value="<%= user.username %>"
            readonly
          />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= user.email %>"
            readonly
          />
        </div>

        <div class="form-group">
          <label for="phone">Nomor Telepon</label>
          <input
            type="text"
            id="phone"
            name="phone"
            value="<%= user.phone %>"
            readonly
          />
        </div>

        <div class="form-buttons">
          <button type="button" class="btn-edit" id="btnEdit">
            Edit Profil
          </button>
          <button
            type="submit"
            class="btn-save"
            id="btnSave"
            style="display: none"
          >
            Simpan Perubahan
          </button>
          <button
            type="button"
            class="btn-cancel"
            id="btnCancel"
            style="display: none"
          >
            Batal
          </button>
        </div>
      </form>
    </div>

    <!-- KANAN: Avatar + Keamanan Akun -->
    <div class="profile-side">
      <!-- Avatar Card -->
      <div class="profile-card avatar-card">
        <div class="avatar-wrap">
          <img src="/Assets/profile.jpg" alt="Avatar" class="avatar-img" />
          <button class="avatar-edit-btn" type="button">
            <i class="bi bi-camera"></i>
          </button>
        </div>
        <p>Nama Member</p>
        <h3><%= user.username %></h3>
      </div>

      <!-- Keamanan Akun Card -->
      <div class="profile-card security-card">
        <div class="card-title">
          <h2>Keamanan Akun</h2>
          <p>Kelola keamanan akun Anda</p>
        </div>

        <ul class="security-list">
          <li>
            <div class="security-item">
              <i class="bi bi-lock"></i>
              <div>
                <span class="security-label">Ubah Password</span>
                <span class="security-desc">Perbarui pasword akun Anda</span>
              </div>
            </div>
            <i class="bi bi-chevron-right"></i>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- VERIFIKASI -->
  <div class="profile-card help-card <% if(user.ktp_status === 'verified') { %>verified<% } else if(user.ktp_status === 'rejected') { %>rejected<% } else if(user.ktp_status === 'pending') { %>pending<% } %>">
    <div class="help-icon">
      <% if(user.ktp_status === 'verified') { %>
        <i class="bi bi-check-circle"></i>
      <% } else if(user.ktp_status === 'rejected') { %>
        <i class="bi bi-x-circle"></i>
      <% } else { %>
        <i class="bi bi-exclamation-circle"></i>
      <% } %>
    </div>
    <div class="help-text">
      <% if(user.ktp_status === 'verified') { %>
        <h4>Identitas Terverifikasi</h4>
        <p>Akun Anda telah berhasil diverifikasi.</p>
      <% } else if(user.ktp_status === 'pending') { %>
        <h4>Sedang Diverifikasi</h4>
        <p>Kartu identitas Anda sedang ditinjau oleh admin. Mohon tunggu.</p>
      <% } else if(user.ktp_status === 'rejected') { %>
        <h4>Verifikasi Ditolak</h4>
        <p>Kartu identitas Anda ditolak. Silakan upload ulang dokumen yang valid.</p>
      <% } else { %>
        <h4>Verifikasi Lebih Lanjut</h4>
        <p>Upload foto Kartu identitas Anda untuk verifikasi identitas lebih lanjut.</p>
      <% } %>
    </div>

    <% if(user.ktp_status === 'unverified') { %>
      <button type="button" class="btn-support" id="btnVerifikasi">Verifikasi</button>
    <% } else if(user.ktp_status === 'pending') { %>
      <button type="button" class="btn-support btn-pending" disabled>Sedang Diverifikasi</button>
    <% } else if(user.ktp_status === 'rejected') { %>
      <button type="button" class="btn-support btn-rejected" id="btnVerifikasi">Verifikasi Ulang</button>
    <% } %>
  </div>

  <!-- MODAL KTP -->
  <div class="ktp-modal-overlay" id="ktpModalOverlay">
    <div class="ktp-modal">
      <div class="ktp-modal-header">
        <div class="ktp-modal-icon">
          <i class="bi bi-person-circle"></i>
        </div>
        <div>
          <h3>Verifikasi Kartu Identitas</h3>
          <p>Upload foto Kartu identitas Anda untuk verifikasi identitas lebih lanjut. Proses review dilakukan oleh admin secara manual.</p>
          <span class="badge-pending"><i class="bi bi-clock"></i> Belum terverifikasi</span>
        </div>
      </div>

      <form action="/profile-customer/upload-ktp" method="POST" enctype="multipart/form-data">
        <div class="ktp-dropzone" id="ktpDropzone">
          <input type="file" id="ktpFile" name="ktp_image" accept=".jpg,.jpeg,.png,.pdf" hidden />
          <i class="bi bi-upload"></i>
          <p>Klik atau seret foto kartu identitas ke sini</p>
          <span>Format: JPG, PNG, PDF · Maks. 5 MB</span>
        </div>
        <p class="ktp-note"><i class="bi bi-shield-lock"></i> Data Anda hanya akan diakses oleh admin terverifikasi.</p>
        <div class="ktp-modal-actions">
          <button type="button" class="btn-cancel-modal" id="btnCancelModal">Batal</button>
          <button type="submit" class="btn-kirim"><i class="bi bi-send"></i> Kirim untuk Diverifikasi</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Script -->
<script>
  const btnEdit = document.getElementById("btnEdit");
  const btnSave = document.getElementById("btnSave");
  const btnCancel = document.getElementById("btnCancel");
  const inputs = document.querySelectorAll(".info-card input");
  const originalValues = {};

  btnEdit.addEventListener("click", () => {
    inputs.forEach((input) => {
      originalValues[input.id] = input.value;
      input.removeAttribute("readonly");
    });
    btnEdit.style.display = "none";
    btnSave.style.display = "block";
    btnCancel.style.display = "block";
  });

  btnCancel.addEventListener("click", () => {
    inputs.forEach((input) => {
      input.value = originalValues[input.id];
      input.setAttribute("readonly", true);
    });
    btnEdit.style.display = "block";
    btnSave.style.display = "none";
    btnCancel.style.display = "none";
  });

  const btnVerifikasi = document.getElementById('btnVerifikasi');
  const ktpModalOverlay = document.getElementById('ktpModalOverlay');
  const btnCancelModal = document.getElementById('btnCancelModal');
  const ktpDropzone = document.getElementById('ktpDropzone');
  const ktpFile = document.getElementById('ktpFile');

  if (btnVerifikasi) {
    btnVerifikasi.addEventListener('click', () => {
      ktpModalOverlay.classList.add('show');
    });
  }

  if (btnCancelModal) {
    btnCancelModal.addEventListener('click', () => {
      ktpModalOverlay.classList.remove('show');
    });
  }

  if (ktpDropzone) {
    ktpDropzone.addEventListener('click', () => ktpFile.click());
    ktpFile.addEventListener('change', () => {
      if (ktpFile.files[0]) {
        ktpDropzone.querySelector('p').textContent = ktpFile.files[0].name;
      }
    });
  }
</script>
