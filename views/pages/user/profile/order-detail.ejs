<%
function formatTanggal(tanggal){
    const bulan = [
        "Januari","Februari","Maret","April",
        "Mei","Juni","Juli","Agustus",
        "September","Oktober","November","Desember"
    ];

    const d = new Date(tanggal);

    return `${d.getDate()} ${bulan[d.getMonth()]} ${d.getFullYear()}`;
}
%>

<div class="top-bar">
    <div class="temp back">
        <a href="/order-user">
            <i class="bi bi-arrow-left"></i>
            <p>Back</p>
        </a>
    </div>
    <div class="temp title">
        <p>Order Detail</p>
    </div>
    <div class="temp logo-title">
        <h1>Lab<span>Ly</span></h1>
    </div>
</div>

<div class="main-content">
    <div class="content tool-info">
        <div class="title">
            <h1>Informasi Alat</h1>
        </div>
        <div class="tool-info-content">
            <div class="tool-img">
                <img src="<%= order.product_image ? '/uploads/' + order.product_image : '/Assets/default.png' %>" alt="">
            </div>
            <div class="tool-text">
                <div class="tool-name"><%= order.product_name %></div>
                <div class="tool">
                    <p class="title-info">Kode alat</p>
                    <p class="title-name">LAB-MIC-<%= String(order.id_products).padStart(3,'0') %></p>
                </div>
                <div class="tool">
                    <div class="title-info">Kategori</div>
                    <div class="title-name"><%= order.category_name %></div>
                </div>
                <div class="tool">
                    <div class="title-info">Kondisi</div>
                    <div class="title-name"><%= order.kondisi %></div>
                </div>
            </div>
        </div>
    </div>

    <div class="content order-summary">
        <div class="title">
            <h1>Ringkasan Peminjaman</h1>
        </div>
        <div class="order-summary-content">
            <div class="order-status">
                <p>Status Order</p>
                <p class="info-status
                    <%= order.status === 'completed'
                    ? 'status-complete'
                    : order.status === 'overdue'
                    ? 'status-overdue'
                    : 'status-active' %>">

                    <%= order.status === 'completed'
                        ? 'Returned'
                        : order.status === 'overdue'
                        ? 'Overdue'
                        : order.status === 'pending'
                        ? 'Paid'
                        : 'In Use'
                    %>
                </p>
            </div>
            <div class="order-sum-info">
                <div class="order-sum1">
                    <div class="order-sum qty">
                        <i class="bi bi-command"></i>
                        <div class="order-sum-text">
                            <p>QTY yang dipinjam</p>
                            <p class="sum-info"><%= order.qty %> Unit</p>
                        </div>
                    </div>
                    <div class="order-sum cost">
                        <i class="bi bi-coin"></i>
                        <div class="order-sum-text">
                            <p>Biaya Peminjaman</p>
                            <p class="sum-info">
                            Rp. <%= Number(order.product_price).toLocaleString('id-ID') %>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="order-sum2">
                    <div class="order-sum duration">
                        <i class="bi bi-clock"></i>
                        <div class="order-sum-text">
                            <p>Durasi Peminjaman</p>
                            <p class="sum-info">
                            <%= formatTanggal(order.tgl_pinjam) %> - <%= formatTanggal(order.tgl_kembali) %>
                            </p>
                        </div>
                    </div>
                    <div class="order-sum total">
                        <i class="bi bi-wallet"></i>
                        <div class="order-sum-text">
                            <p>Total Biaya</p>
                            <p class="sum-info">
                            Rp. <%= Number(order.price).toLocaleString('id-ID') %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="add-duration">
                <button><i class="bi bi-plus"></i> Tambah Durasi Peminjaman</button>
            </div>
        </div>
    </div>

    <div class="content order-info">
    <div class="title">
        <h1>Informasi Peminjam</h1>
    </div>

    <div class="borrower-content">

        <div class="borrow-item">
            <div class="borrow-label">
                <i class="bi bi-person-fill"></i>
                <span>Nama</span>
            </div>

            <div class="borrow-value">
                <%= order.username %>
            </div>
        </div>

        <div class="borrow-item">
            <div class="borrow-label">
                <i class="bi bi-envelope-fill"></i>
                <span>Email</span>
            </div>

            <div class="borrow-value">
                <%= order.email %>
            </div>
        </div>

        <div class="borrow-item">
            <div class="borrow-label">
                <i class="bi bi-telephone-fill"></i>
                <span>Nomor HP</span>
            </div>

            <div class="borrow-value">
                <%= order.phone || '-' %>
            </div>
        </div>

    </div>
</div>  

    <% 
        const status = (order.status || '').toString().toLowerCase();
        const timelineSteps = [
            { label: 'Peminjaman dibuat', date: order.created_at || order.tgl_pinjam || null },
            { label: 'Pembayaran Berhasil', date: order.paid_at || order.payment_date || null },
            { label: 'Barang diambil', date: order.picked_at || null },
            { label: 'Barang dikembalikan', date: order.returned_at || order.tgl_kembali || null }
        ];
        let completedCount = 1;
        if (status === 'pending') {
            completedCount = 2;
        }
        if (status === 'in use') {
            completedCount = 3;
        }
        if (status === 'overdue') {
            completedCount = 3;
        }
        if (status === 'completed') {
            completedCount = 4;
        }
    %>

    <div class="content order-timeline">
        <div class="title">
            <h1>Timeline</h1>
        </div>
        <div class="timeline-container">
            <div class="path">
                <% timelineSteps.forEach(function(step, idx) { 
                    const done = idx < completedCount; %>
                    <div class="circle <%= done ? 'completed' : '' %>"></div>
                    <% if (idx < timelineSteps.length - 1) { %>
                        <div class="line <%= (idx + 2) <= completedCount ? 'completed' : '' %>"></div>
                    <% } %>
                <% }); %>
            </div>
            <div class="timeline-info">
                <% timelineSteps.forEach(function(step, idx) { %>
                    <div>
                        <% if (idx < completedCount) { %>
                            <% if (idx === 2) { %>
                                <%= step.label %> (<%= status === 'overdue' ? 'Overdue' : 'In use' %>)
                            <% } else { %>
                                <%= step.label %>
                            <% } %>
                        <% } %>
                    </div>
                    <% if (idx < timelineSteps.length - 1) { %><div></div><% } %>
                <% }); %>
            </div>
        </div>
    </div>

    <div class="content payment">
        <div class="title">
            <h1>Informasi Pembayaran</h1>
        </div>
    </div>

    <div class="content return">
    <div class="title">
        <h1>Informasi Pengembalian</h1>
    </div>

    <div class="return-content">

        <div class="return-status">

            <% if(order.status === 'completed'){ %>

                <span class="returned">
                    <i class="bi bi-check-circle-fill"></i>
                    Sudah Dikembalikan
                </span>

            <% } else if(order.status === 'overdue'){ %>

                <span class="overdue">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    Terlambat Dikembalikan
                </span>

            <% } else { %>

                <span class="not-returned">
                    <i class="bi bi-clock-fill"></i>
                    Belum Dikembalikan
                </span>

            <% } %>

        </div>

        <div class="return-date">

            <% if(order.status === 'completed'){ %>

                <p>Barang sudah dikembalikan dengan aman.</p>

            <% } else { %>

                <p>Pengembalian dilakukan sebelum atau pada</p>

                <strong>
                    <%= formatTanggal(order.tgl_kembali) %>
                </strong>

            <% } %>

        </div>

    </div>
</div>      
</div>