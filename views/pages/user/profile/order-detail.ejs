<div class="top-bar">
    <div class="temp back">
        <a href="/order-user">
            <i class="bi bi-arrow-left"></i>
            <p>Back</p>
        </a>
    </div>
    <div class="temp title">
        <p>Order Detail</p>
    </div>
    <div class="temp logo-title">
        <h1>Lab<span>Ly</span></h1>
    </div>
</div>

<div class="main-content">
    <div class="content tool-info">
        <div class="title">
            <h1>Informasi Alat</h1>
        </div>
        <div class="tool-info-content">
            <div class="tool-img">
                <img src="/uploads/1764587234242-Mickroscope.png" alt="">
            </div>
            <div class="tool-text">
                <div class="tool-name">Mikroskop</div>
                <div class="tool">
                    <p class="title-info">Kode alat</p>
                    <p class="title-name">LAB-MIC-001</p>
                </div>
                <div class="tool">
                    <div class="title-info">Kategori</div>
                    <div class="title-name">anu anu anu</div>
                </div>
                <div class="tool">
                    <div class="title-info">Kondisi</div>
                    <div class="title-name">Baik</div>
                </div>
            </div>
        </div>
    </div>

    <div class="content order-summary">
        <div class="title">
            <h1>Ringkasan Peminjaman</h1>
        </div>
        <div class="order-summary-content">
            <div class="order-status">
                <p>Status Order</p>
                <p class="info-status">In Use</p>
            </div>
            <div class="order-sum-info">
                <div class="order-sum1">
                    <div class="order-sum qty">
                        <i class="bi bi-command"></i>
                        <div class="order-sum-text">
                            <p>QTY yang dipinjam</p>
                            <p class="sum-info">1 Unit</p>
                        </div>
                    </div>
                    <div class="order-sum cost">
                        <i class="bi bi-coin"></i>
                        <div class="order-sum-text">
                            <p>Biaya Peminjaman</p>
                            <p class="sum-info">Rp. 1.000.000</p>
                        </div>
                    </div>
                </div>
                <div class="order-sum2">
                    <div class="order-sum duration">
                        <i class="bi bi-clock"></i>
                        <div class="order-sum-text">
                            <p>Durasi Peminjaman</p>
                            <p class="sum-info">31 Mei 2026 - 31 Juni 2026</p>
                        </div>
                    </div>
                    <div class="order-sum total">
                        <i class="bi bi-wallet"></i>
                        <div class="order-sum-text">
                            <p>Biaya Peminjaman</p>
                            <p class="sum-info">Rp. 1.000.000</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="add-duration">
                <button><i class="bi bi-plus"></i> Tambah Durasi Peminjaman</button>
            </div>
        </div>
    </div>

    <div class="content order-info">
        <div class="title">
            <h1>Informasi Peminjam</h1>
        </div>
    </div>   

    <div class="content order-timeline">
        <div class="title">
            <h1>Timeline</h1>
        </div>
    </div>

    <div class="content payment">
        <div class="title">
            <h1>Informasi Pembayaran</h1>
        </div>
    </div>

    <div class="content return">
        <div class="title">
            <h1>Informasi Pengembalian</h1>
        </div>
    </div>        
</div>