<nav class="navbar">
  <span>Orders Completed</span>
  <img src="Assets/profile.jpg" alt="" />
</nav>

<!-- ORDER TOTAL INFO -->
<div class="order-info">
  <div class="box">
    <div class="total"><%= totalCompleted %></div>
    <div class="detail-pending">
      <span class="pending">ITEMS</span>
      <span>ORDERS COMPLETED</span>
    </div>
  </div>
</div>

<!-- SEARCH -->
<div class="filter">
  <div class="search search-form">
    <form
      action="/order-completed"
      method="GET"
      style="display: flex; width: 100%"
    >
      <input
        type="text"
        name="search"
        placeholder="Search"
        value="<%= search || '' %>"
      />
      <button type="submit" class="btn-search">
        <i class="bi bi-search"></i>
      </button>
    </form>
  </div>
</div>

<!-- FILTER BUTTONS + DATE RANGE -->
<div class="menu-option">
  <div class="menu-options">
    <!-- ALL -->
    <form action="/order-completed" method="GET">
      <button type="submit" class="btn-search <%= !filter ? 'active' : '' %>">
        All
      </button>
    </form>

    <!-- COMPLETED -->
    <form action="/order-completed" method="GET">
      <input type="hidden" name="filter" value="completed" />
      <button
        type="submit"
        class="btn-search <%= filter === 'completed' ? 'active' : '' %>"
      >
        Completed
      </button>
    </form>

    <!-- COMPLETED OVERDUE -->
    <form action="/order-completed" method="GET">
      <input type="hidden" name="filter" value="overdue" />
      <button
        type="submit"
        class="btn-search <%= filter === 'overdue' ? 'active' : '' %>"
      >
        Completed Overdue
      </button>
    </form>
  </div>

  <!-- DATE FILTER -->
  <div class="date">
    <form
      action="/order-completed"
      method="GET"
      style="display: flex; gap: 5px"
    >
      <input type="date" name="start" value="<%= start || '' %>" />

      :

      <input type="date" name="end" value="<%= end || '' %>" />

      <button type="submit" class="btn-search" style="border-radius: 5px">
        Filter
      </button>
    </form>
  </div>
</div>

<!-- TITLE -->
<div class="page-text">
  <span>List Of All Orders Completed</span>
</div>

<!-- TABLE -->
<div class="customer-table">
  <table>
    <thead>
      <tr class="even">
        <th>No</th>
        <th>Customer</th>
        <th>Equipment</th>
        <th>Loan Period</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
      <% if (!orders || orders.length === 0) { %>
      <tr>
        <td colspan="5" style="text-align: center; padding: 20px">
          No completed orders found.
        </td>
      </tr>
      <% } else { %> <% orders.forEach((o, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= o.username %></td>
        <td><%= o.product_name %></td>

        <!-- Loan Period (tanggal saja) -->
        <td>
          <%= o.tgl_pinjam ? o.tgl_pinjam.split(" ")[0] : '' %> - <%=
          o.tgl_kembali ? o.tgl_kembali.split(" ")[0] : '' %>
        </td>

        <!-- STATUS LOGIC -->
        <td
          class="<%= o.overdue_flag == 1 ? 'status-completed-overdue' : 'status-completed' %>"
        >
          <%= o.overdue_flag == 1 ? "Completed Overdue" : "Completed" %>
        </td>
      </tr>
      <% }) %> <% } %>
    </tbody>
  </table>
</div>
