<div class="category-container">

    <!-- TOPBAR -->
    <div class="admin-topbar">
        <img src="/Assets/profile.jpg" class="admin-profile">
    </div>

    <!-- CATEGORY CARD -->
    <div class="category-card">

        <div class="header-row">
            <h2 class="category-title">Category</h2>

            <a href="/category/create" class="btn-add-category">
                Add Category
            </a>
        </div>

        <table class="category-table">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% categories.forEach((c, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><%= c.name %></td>
                        <td>
                            <a href="/category/edit/<%= c.id %>" class="btn-edit">Update</a>
                            <a href="/category/delete/<%= c.id %>" class="btn-delete">Delete</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    </div>

</div>
