<nav class="navbar">
  <span>Product List</span>
  <img src="/Assets/profile.jpg" alt="" />
</nav>

<section class="controls-section">
  <div class="search-bar">
    <i class="bi bi-search"></i>
    <input
      type="text"
      id="searchInput"
      placeholder="Search Products"
      autocomplete="off"
      value="<%= search || '' %>"
    />
    <button class="search-button" type="button" id="searchButton">
      <i class="bi bi-arrow-right"></i>
    </button>
  </div>

  <a href="/product-create" class="add-product-button">
    <i class="bi bi-plus-circle"></i>
    Add Product
  </a>
</section>

<script id="product-data-json" type="application/json">
    <%- JSON.stringify(ALL_PRODUCTS) %>
</script>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th class="col-no">No</th>
        <th>Name</th>
        <th>Stock</th>
        <th>Price</th>
        <th>Category</th>
        <th class="col-action">Action</th>
      </tr>
    </thead>

    <tbody>
      <% if (!products || products.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align:center; padding:20px;">No products found</td>
        </tr>
      <% } else { %>

        <% products.forEach((p, i) => { %>
          <tr>
            <td><%= (currentPage - 1) * limit + (i + 1) %></td>
            <td><%= p.name %></td>
            <td><%= p.stock %></td>
            <td>Rp <%= Number(p.price).toLocaleString("id-ID") %></td>
            <td><%= p.category_name %></td>

            <td class="btn">
              <a href="/product-detail/<%= p.id %>" class="btn-action update">Update</a>

              <button
                type="button"
                class="btn-action delete"
                onclick='openDeleteModal(<%= p.id %>, <%- JSON.stringify(p.name) %>)'>
                Delete
              </button>
            </td>
          </tr>
        <% }) %>

      <% } %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<div class="pagination">
  <% if (totalPages > 1) { %>
    <% for (let page = 1; page <= totalPages; page++) { %>
      <button
        class="page-number <%= page === currentPage ? "active" : "" %>"
        onclick="changePage(<%= page %>)">
        <%= page %>
      </button>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <button
        class="page-next"
        onclick="changePage(<%= currentPage + 1 %>)">
        NEXT <i class="bi bi-chevron-right"></i>
      </button>
    <% } %>
  <% } %>
</div>

<!-- Delete Confirmation Modal -->
<div class="delete-modal-overlay">
  <div class="delete-modal">
    <div class="delete-modal-header">
      <span>⚠️ Confirm Delete</span>
    </div>
    <div class="delete-modal-body">
      <p>Are you sure you want to delete product "<span id="deleteProductName"></span>"?</p>
      <p>This action cannot be undone.</p>
    </div>
    <div class="delete-modal-actions">
      <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
      <button type="button" class="btn-confirm-delete" onclick="confirmDelete()">Delete</button>
    </div>
  </div>
</div>

<script>
    // =====================================
    // INIT & AMBIL DATA MENTAH
    // =====================================
    const searchInput = document.getElementById("searchInput");
    const searchButton = document.getElementById("searchButton");
    const tableBody = document.querySelector("tbody");
    const pagination = document.querySelector(".pagination");

    // 💡 AMBIL SEMUA DATA PRODUK DARI JSON YANG DISEDIKAN EJS
    const productDataJson = document.getElementById("product-data-json").textContent; 
    const productsData = JSON.parse(productDataJson); 

    const ROWS_PER_PAGE = 5;
    let currentPage = 1;

    // =====================================
    // HELPER: CREATE ROW
    // =====================================

    // Fungsi untuk membuat baris TR dari objek produk mentah
    function createRow(p, index) {
        const tr = document.createElement("tr");
        tr.innerHTML = `
            <td>${index}</td>
            <td>${p.name}</td>
            <td>${p.stock}</td>
            <td>Rp ${Number(p.price).toLocaleString("id-ID")}</td>
            <td>${p.category_name}</td>
            <td class="btn">
                <a href="/product-detail/${p.id}" class="btn-action update">Update</a>
                <button
                    type="button"
                    class="btn-action delete"
                    onclick='openDeleteModal(${p.id}, "${p.name.replace(/"/g, '\\"')}")'>
                    Delete
                </button>
            </td>
        `;
        return tr;
    }

    // =====================================
    // RENDER TABLE (PAGING & FILTERING LOGIC)
    // =====================================
    function renderTable() {
        const q = searchInput.value.toLowerCase().trim();

        // 1. FILTERING
        const filteredProducts = productsData.filter(p => {
            // Membersihkan teks harga agar pencarian angka berhasil
            const priceClean = String(p.price).replace(/\./g, '').toLowerCase(); 

            return (
                p.name.toLowerCase().includes(q) ||
                String(p.stock).includes(q) ||
                priceClean.includes(q) ||
                p.category_name.toLowerCase().includes(q)
            );
        });

        const totalProducts = filteredProducts.length;
        const totalPages = Math.ceil(totalProducts / ROWS_PER_PAGE);

        if (currentPage > totalPages) currentPage = 1;
        if (currentPage < 1 && totalProducts > 0) currentPage = 1;

        const start = (currentPage - 1) * ROWS_PER_PAGE;
        const pageRowsData = filteredProducts.slice(start, start + ROWS_PER_PAGE);

        // 2. Clear table dan render baris
        tableBody.innerHTML = "";

        if (totalProducts === 0) {
            tableBody.innerHTML = `
            <tr>
                <td colspan="6" style="text-align:center; padding:20px;">No products found</td>
            </tr>`;
        } else {
            pageRowsData.forEach((p, i) => {
                // Urutan nomor baris (start + i + 1)
                const row = createRow(p, start + i + 1); 
                tableBody.appendChild(row);
            });
        }

        // 3. Render Pagination
        renderPagination(totalPages);
    }

    // =====================================
    // RENDER PAGINATION
    // =====================================
    function renderPagination(totalPages) {
        pagination.innerHTML = "";

        if (totalPages <= 1) return;

        for (let page = 1; page <= totalPages; page++) {
            const btn = document.createElement("button");
            btn.classList.add("page-number");
            btn.textContent = page;

            if (page === currentPage) btn.classList.add("active");

            btn.onclick = () => {
                currentPage = page;
                renderTable();
            };

            pagination.appendChild(btn);
        }

        if (currentPage < totalPages) {
            const next = document.createElement("button");
            next.classList.add("page-next");
            next.innerHTML = `NEXT <i class="bi bi-chevron-right"></i>`;
            next.onclick = () => {
                currentPage++;
                renderTable();
            };
            pagination.appendChild(next);
        }
    }

    // =====================================
    // SEARCH (EVENT LISTENERS)
    // =====================================
    let typingTimer;
    const delay = 300;

    function applySearchFilter() {
        currentPage = 1;
        renderTable();
    }

    searchInput.addEventListener("input", () => {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(applySearchFilter, delay);
    });

    searchButton.addEventListener("click", applySearchFilter);

    searchInput.addEventListener("keypress", e => {
        if (e.key === "Enter") {
            e.preventDefault();
            applySearchFilter();
        }
    });

    // =====================================
    // DELETE MODAL (GLOBAL FUNCTIONS)
    // =====================================
    let deleteProductId = null;

    // 💡 Definisikan di scope global agar bisa dipanggil dari onclick=""
    window.openDeleteModal = function(id, name) {
        deleteProductId = id;
        document.getElementById("deleteProductName").textContent = name;
        document.querySelector(".delete-modal-overlay").classList.add("show");
    }

    // 💡 Definisikan di scope global
    window.closeDeleteModal = function() {
        document.querySelector(".delete-modal-overlay").classList.remove("show");
        deleteProductId = null;
    }

    // 💡 Definisikan di scope global
    window.confirmDelete = function() {
        if (deleteProductId) {
            window.location.href = "/product/delete/" + deleteProductId;
        }
    }

    // Render awal
    renderTable();
</script>