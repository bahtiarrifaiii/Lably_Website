<nav class="navbar">
  <span>Product Detail</span>
  <img src="Assets/profile.jpg" alt="" />
</nav>

<section class="form-card">
  <h2 class="form-card-title">Product Detail</h2>
  <form class="product-form">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" value="anu anu" />
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <input type="text" id="description" value="Small, clean, good good" />
    </div>

    <div class="form-group">
      <label for="category">Category</label>
      <input type="text" id="category" value="blabla" />
    </div>
    <div class="form-group">
      <label for="stock">Stok</label>
      <input type="number" id="stock" value="5" />
    </div>

    <div class="form-group">
      <label for="condition">Condition</label>
      <input type="text" id="condition" value="Good" />
    </div>
    <div class="form-group">
      <label for="price">Price</label>
      <input type="text" id="price" value="Rp. 200.000,00" />
    </div>

    <div class="form-group full-width product-image-group">
      <label>Product Image :</label>
      <div class="image-display-wrapper">
        <img
          src="./assets/Mickroscope.png"
          alt="Product Image"
          class="product-current-image"
        />
      </div>
    </div>

    <div class="form-group full-width file-upload-group">
      <label>Change Image</label>
      <div class="file-input-wrapper">
        <input type="file" id="changeImage" class="hidden-file-input" />
        <label for="changeImage" class="custom-file-button">Choose File</label>
        <span class="file-name">No File Choosen</span>
      </div>
    </div>

    <div class="form-actions full-width">
      <a href="/product-list" type="button" class="btn-back">BACK</a>
      <a href="/product-list" type="submit" class="btn-update-product"
        >UPDATE PRODUCT</a
      >
    </div>
  </form>
</section>
