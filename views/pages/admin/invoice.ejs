<nav class="navbar">
  <span>Invoice</span>
  <img src="Assets/profile.jpg" alt="" />
</nav>

<section class="controls-section">
  <div class="total-checkout">
    <i class="bi bi-cart-check"></i>
    <h2><%= orders.length %> ORDERS</h2>
  </div>
  <a href="#" class="print-button" onclick="window.print(); return false;">
    <i class="bi bi-printer"></i>
    Print PDF
  </a>
</section>

<!-- PRINT HEADER  -->
<div class="print-header">
  <h1>Lably Official Invoice</h1>
  <p>
    Green Office Park 9, BSD City, Tangerang Selatan 15345<br />
    021-3456-887 - info@lably.com
  </p>
  <hr />
</div>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th class="col-no">No</th>
        <th class="col-name">Customer</th>
        <th>Equipment</th>
        <th>Loan Period</th>
        <th>Status</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      <% if (!orders || orders.length === 0) { %>
      <tr>
        <td colspan="6" style="text-align: center; padding: 15px">
          No completed orders
        </td>
      </tr>
      <% } else { %> <% orders.forEach((o, i) => { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= o.customer_name %></td>
        <td><%= o.product_name %></td>
        <td><%= o.tgl_pinjam %> - <%= o.tgl_kembali %></td>
        <td class="complete">Completed</td>

        <td>Rp <%= Number(o.price).toLocaleString("id-ID") %></td>
      </tr>
      <% }) %> <% } %>
    </tbody>
  </table>
</div>
