<!-- customer-detail.ejs -->

<div class="profile-content">
  <!-- HEADER -->
  <div class="profile-header">
    <a href="/customer" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
    <h1>Detail Customer</h1>
    <p>Informasi lengkap akun customer</p>
  </div>

  <div class="profile-body">
    <!-- KIRI: Informasi Pribadi (readonly) -->
    <div class="profile-card info-card">
      <div class="card-title">
        <h2>Informasi Pribadi</h2>
        <p>Data akun customer</p>
      </div>

      <div class="form-group">
        <label>Nama Lengkap</label>
        <input type="text" value="<%= user.username %>" readonly />
      </div>

      <div class="form-group">
        <label>Email</label>
        <input type="email" value="<%= user.email %>" readonly />
      </div>

      <div class="form-group">
        <label>Nomor Telepon</label>
        <input type="text" value="<%= user.phone || '-' %>" readonly />
      </div>

      <div class="form-group">
        <label>Status Akun</label>
        <input type="text" value="<%= user.status %>" readonly />
      </div>

      <div class="form-group">
        <label>Tanggal Bergabung</label>
        <input type="text" value="<%= user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID') : '-' %>" readonly />
      </div>
    </div>

    <!-- KANAN: Foto KTP -->
    <div class="profile-side">
      <div class="profile-card avatar-card">
        <% if(user.ktp_image) { %>
          <img src="<%= user.ktp_image %>" alt="Foto KTP" class="ktp-preview-img" />
          <p class="ktp-label">Foto Kartu Identitas</p>
        <% } else { %>
          <div class="ktp-empty">
            <i class="bi bi-person-vcard"></i>
            <p>Belum ada foto KTP</p>
          </div>
        <% } %>
      </div>

      <!-- Status KTP -->
      <div class="profile-card security-card">
        <div class="card-title">
          <h2>Status Verifikasi</h2>
          <p>Status kartu identitas customer</p>
        </div>
        <div class="ktp-status-info">
          <% if(user.ktp_status === 'verified') { %>
            <span class="ktp-badge verified"><i class="bi bi-check-circle"></i> Terverifikasi</span>
          <% } else if(user.ktp_status === 'pending') { %>
            <span class="ktp-badge pending"><i class="bi bi-clock"></i> Menunggu Verifikasi</span>
          <% } else if(user.ktp_status === 'rejected') { %>
            <span class="ktp-badge rejected"><i class="bi bi-x-circle"></i> Ditolak</span>
          <% } else { %>
            <span class="ktp-badge unverified"><i class="bi bi-dash-circle"></i> Belum Diverifikasi</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- APPROVAL -->
  <div class="profile-card help-card
    <% if(user.ktp_status === 'verified') { %>verified
    <% } else if(user.ktp_status === 'rejected') { %>rejected
    <% } else if(user.ktp_status === 'pending') { %>pending<% } %>">

    <div class="help-icon">
      <% if(user.ktp_status === 'verified') { %>
        <i class="bi bi-check-circle"></i>
      <% } else if(user.ktp_status === 'rejected') { %>
        <i class="bi bi-x-circle"></i>
      <% } else { %>
        <i class="bi bi-exclamation-circle"></i>
      <% } %>
    </div>

    <div class="help-text">
      <% if(user.ktp_status === 'verified') { %>
        <h4>Identitas Terverifikasi</h4>
        <p>Customer ini telah berhasil diverifikasi.</p>
      <% } else if(user.ktp_status === 'rejected') { %>
        <h4>Verifikasi Ditolak</h4>
        <p>Kartu identitas customer telah ditolak.</p>
      <% } else if(user.ktp_status === 'pending') { %>
        <h4>Menunggu Persetujuan</h4>
        <p>Customer telah mengupload kartu identitas dan menunggu verifikasi admin.</p>
      <% } else { %>
        <h4>Belum Diverifikasi</h4>
        <p>Customer belum mengupload kartu identitas.</p>
      <% } %>
    </div>

    <!-- Tombol approval hanya muncul saat pending -->
    <% if(user.ktp_status === 'pending') { %>
      <div class="approval-actions">
        <form action="/customer/<%= user.id %>/approve-ktp" method="POST" style="display:inline">
          <button type="submit" class="btn-approve">
            <i class="bi bi-check-lg"></i> Approve
          </button>
        </form>
        <form action="/customer/<%= user.id %>/reject-ktp" method="POST" style="display:inline">
          <button type="submit" class="btn-reject">
            <i class="bi bi-x-lg"></i> Reject
          </button>
        </form>
      </div>
    <% } %>
  </div>
</div>